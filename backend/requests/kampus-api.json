{
  "info": {
    "_postman_id": "88a5b42d-9c8c-48c5-83ae-f9fc792b4065",
    "name": "Kampüs Etkinlikleri API",
    "description": "Sprint 7 Express API için altı temel istek.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('status ve öğrenci numarası döner', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('ok'); pm.expect(body.student).to.eql('2416501007'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET /events",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK ve altı başlangıç etkinliği', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.lengthOf(6); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET /events/event-2",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/events/event-2", "host": ["{{baseUrl}}"], "path": ["events", "event-2"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK ve doğru id', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql('event-2'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. GET /events/yok (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/events/yok", "host": ["{{baseUrl}}"], "path": ["events", "yok"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 ve error.message biçimi', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().error.message).to.eql('Event not found'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. POST /events (tam gövde)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman İletişim Atölyesi\",\n  \"category\": \"Atölye\",\n  \"date\": \"2026-12-01\",\n  \"time\": \"13:00\",\n  \"location\": \"Bilgisayar Laboratuvarı 1\",\n  \"description\": \"REST API üzerinden eklenen örnek etkinlik.\",\n  \"capacity\": 24\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created ve id üretildi', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().id).to.match(/^event-/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. POST /events (yalnızca title, 400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Eksik etkinlik\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 ve error.message biçimi', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.message).to.eql('title, category and date are required'); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ]
}
